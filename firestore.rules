rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == "gourav6746@gmail.com";
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Collection validation & control rules

    // 1. Team Members (Teachers and Staff records)
    match /team_members/{memberId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(memberId);
    }

    // 2. News and Events
    match /news_and_events/{newsId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(newsId);
    }

    // 3. Notices
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(noticeId);
    }

    // 4. Gallery Images (Photo items)
    match /gallery_images/{galleryId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(galleryId);
    }

    // 5. Achievements (Honors & milestones)
    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(achievementId);
    }

    // 6. Contact Configurations (Main settings document)
    match /contact_configurations/{configId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(configId);
    }

    // 7. Homepage Configurations (Hero text and metrics)
    match /homepage_configurations/{configId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(configId);
    }
  }
}
