{
  "entities": {
    "TeamMember": {
      "title": "Team Member",
      "description": "Represents a teacher, staff member, or administrator",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nameEn": { "type": "string" },
        "nameNp": { "type": "string" },
        "roleEn": { "type": "string" },
        "roleNp": { "type": "string" },
        "category": { "type": "string" },
        "order": { "type": "integer" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["id", "nameEn", "roleEn", "category"]
    },
    "NewsAndEvent": {
      "title": "News & Event",
      "description": "An article or update about school activities and events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titleEn": { "type": "string" },
        "titleNp": { "type": "string" },
        "descEn": { "type": "string" },
        "descNp": { "type": "string" },
        "date": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["id", "titleEn", "date"]
    },
    "Notice": {
      "title": "Notice",
      "description": "Official school notice or announcement",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titleEn": { "type": "string" },
        "titleNp": { "type": "string" },
        "descEn": { "type": "string" },
        "descNp": { "type": "string" },
        "date": { "type": "string" },
        "isNew": { "type": "boolean" }
      },
      "required": ["id", "titleEn", "date"]
    },
    "GalleryImage": {
      "title": "Gallery Image",
      "description": "Photo displayed in the photo gallery",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titleEn": { "type": "string" },
        "titleNp": { "type": "string" },
        "descEn": { "type": "string" },
        "descNp": { "type": "string" },
        "src": { "type": "string" },
        "order": { "type": "integer" }
      },
      "required": ["id", "src"]
    },
    "Achievement": {
      "title": "Achievement",
      "description": "Highlights school or student achievements and awards",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titleEn": { "type": "string" },
        "titleNp": { "type": "string" },
        "descEn": { "type": "string" },
        "descNp": { "type": "string" },
        "date": { "type": "string" },
        "iconName": { "type": "string" },
        "order": { "type": "integer" }
      },
      "required": ["id", "titleEn"]
    },
    "ContactConfig": {
      "title": "Contact Configuration",
      "description": "School contact and social media configurations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "phone1": { "type": "string" },
        "phone2": { "type": "string" },
        "email": { "type": "string" },
        "addressEn": { "type": "string" },
        "addressNp": { "type": "string" },
        "facebookUrl": { "type": "string" },
        "youtubeUrl": { "type": "string" },
        "twitterUrl": { "type": "string" }
      },
      "required": ["id"]
    },
    "HomepageConfig": {
      "title": "Homepage Configuration",
      "description": "Homepage greetings and dynamic Hero quotes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "welcomeTitleEn": { "type": "string" },
        "welcomeTitleNp": { "type": "string" },
        "welcomeSubtitleEn": { "type": "string" },
        "welcomeSubtitleNp": { "type": "string" },
        "principalQuoteEn": { "type": "string" },
        "principalQuoteNp": { "type": "string" },
        "principalNameEn": { "type": "string" },
        "principalNameNp": { "type": "string" },
        "welcomeIntroductionEn": { "type": "string" },
        "welcomeIntroductionNp": { "type": "string" }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "team_members": {
      "schema": "TeamMember",
      "description": "Teachers list and staff records for school board page"
    },
    "news_and_events": {
      "schema": "NewsAndEvent",
      "description": "News feeds and school updates"
    },
    "notices": {
      "schema": "Notice",
      "description": "School board notices"
    },
    "gallery_images": {
      "schema": "GalleryImage",
      "description": "Visual photos displayed on the media pages"
    },
    "achievements": {
      "schema": "Achievement",
      "description": "School achievements, honors, and milestones"
    },
    "contact_configurations": {
      "schema": "ContactConfig",
      "description": "Main contact numbers and channels for footer/contact area"
    },
    "homepage_configurations": {
      "schema": "HomepageConfig",
      "description": "Dynamic strings on the landing hero section"
    }
  }
}
